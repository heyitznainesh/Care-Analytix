@page "/"
@using CareAnalytixWebChat.Services
@using CareAnalytixWebChat.Data
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@inject FoundryPhiService AI
@inject DatabaseQueryService DbQueryService
@inject IServiceProvider ServiceProvider
@inject IWebHostEnvironment Env
@rendermode InteractiveServer

<PageTitle>IZY Dashboard</PageTitle>

<!-- Top Navbar -->
<div class="top-navbar">
    <div class="nav-left">
        <div style="display: flex; align-items: center; gap: 10px;">
            <img src="images/brand-logo-medical-bot.jpg" style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-color);" alt="IZY Logo" />
            <div class="brand">IZY</div>
        </div>
        <div class="breadcrumbs">Dashboards > Ask</div>
        <div class="nav-badges">
            <span class="nav-badge"><span style="color:var(--primary)">●</span> Acme Health Plan</span>
            <span class="nav-badge">Medicare Advantage</span>
            <span class="nav-badge">All Risk Tiers</span>
        </div>
    </div>
    <div class="nav-right">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
        <div style="position: relative;">
            <div @onclick="ToggleLogoutMenu" class="user-profile" style="cursor: pointer; color:inherit;">
                <div class="avatar">DU</div>
                <div style="display:flex; flex-direction:column; line-height: 1.2;">
                    <span style="font-weight:bold;">Dev User</span>
                    <span style="font-size:0.75rem; color:var(--text-muted);">asu@@...</span>
                </div>
            </div>
            
            @if(ShowLogoutMenu)
            {
                <div style="position: absolute; top: 100%; right: 0; margin-top: 10px; background: white; border: 1px solid var(--border-color); border-radius: 8px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 150px; z-index: 100;">
                    <a href="/login" style="display: block; padding: 10px 15px; color: var(--red-text); text-decoration: none; border-bottom: 1px solid var(--border-color); font-weight: 500;">Log out</a>
                    <div @onclick="CancelLogout" style="display: block; padding: 10px 15px; cursor: pointer; color: var(--text-main); font-weight: 500;">Cancel</div>
                </div>
            }
        </div>
    </div>
</div>

<!-- Page Header -->
<div class="page-header">
    <h1 class="page-title">IZY</h1>
</div>

<!-- Dashboard Container -->
<div class="dashboard-container">
    
    <!-- Left Column (Plan Context & User Details) -->
    <div class="left-column">
        <div class="panel-title" style="margin-bottom:0;">Plan Context & User Details</div>
        
        <div class="plan-context">
            <div class="plan-header">
                <div>
                    <div class="plan-name">@(SelectedPatient != null ? SelectedPatient.Name : "Overall Population")</div>
                    <div class="mt-2" style="color:var(--text-muted); font-size: 0.9rem;">
                        @(SelectedPatient != null ? SelectedPatient.HealthCarePlan : "All Health Plans")
                    </div>
                </div>
            </div>
            
            <div class="metrics-grid">
                <div class="metric-card">
                    <div class="metric-title">@(SelectedPatient != null ? "PMPM (Current)" : "Avg PMPM")</div>
                    <div class="metric-value">@((SelectedPatient != null) ? $"${SelectedPatient.Pmpm:0.##}" : $"${OverallPmpm:0.##}")</div>
                </div>
                <div class="metric-card">
                    <div class="metric-title">@(SelectedPatient != null ? "Risk Tier" : "High/Critical Risk")</div>
                    <div class="metric-value text-yellow" style="font-size:1.6rem;">@((SelectedPatient != null) ? SelectedPatient.RiskTier : OverallRiskTier)</div>
                </div>
                <div class="metric-card">
                    <div class="metric-title">@(SelectedPatient != null ? "ER Utilization" : "Avg ER Util.")</div>
                    <div class="metric-value">@((SelectedPatient != null) ? $"{SelectedPatient.ERUtilization:0.##}%" : $"{OverallER:0.##}%")</div>
                </div>
                <div class="metric-card">
                    <div class="metric-title">@(SelectedPatient != null ? "Open Care Gaps" : "Total Care Gaps")</div>
                    <div class="metric-value text-red">@((SelectedPatient != null) ? SelectedPatient.OpenCareGaps.ToString() : OverallCareGaps.ToString())</div>
                </div>
            </div>
            
            <div class="risk-signals">
                <div class="metric-title" style="font-weight:600; color:var(--text-main);">Key Risk Signals</div>
                <div class="signal-item">
                    <div class="dot red"></div>
                    Critical Inpatient Admission Surge (+11.8%)
                </div>
                <div class="signal-item">
                    <div class="dot yellow"></div>
                    Warning Diabetes Care Gap Compliance Low
                </div>
            </div>
        </div>
    </div>
    
    <!-- Right Column (AI Executive Analyst Area / Scribe Health) -->
    <div class="right-column">
        <div class="chat-header">
            <div style="display:flex; align-items:center; gap:10px;">
                <img src="images/brand-logo-medical-bot.jpg" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover; border: 1px solid var(--border-color);" alt="IZY" />
                IZY
            </div>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
        </div>
        
        <div class="chat-body">

            <!-- Dynamic Messages -->
            @foreach(var msg in Messages)
            {
                if(msg.Role == "User")
                {
                    <div class="user-message">
                        <div class="user-msg-header">Dev User</div>
                        <div>@msg.Text</div>
                    </div>
                }
                else
                {
                    <div class="ai-message">
                        <div class="ai-msg-header">
                            <img src="images/brand-logo-medical-bot.jpg" style="width: 38px; height: 38px; border-radius: 50%; object-fit: cover;" alt="IZY" />
                            IZY
                        </div>
                        <div class="ai-msg-title">Response</div>
                        <div>@msg.Text</div>
                    </div>
                }
            }
            
        </div>
        
        <div class="chat-input-container">
            <div class="chat-input-wrapper">
                <input @bind="CurrentMessage" @bind:event="oninput" @onkeyup="HandleKeyUp" class="chat-input" placeholder="Ask about HMO performance, provider outliers, or utilization drivers..." />
                <button @onclick="SendMessage" disabled="@IsLoading" class="send-btn">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="22" y1="2" x2="11" y2="13"></line><polygon points="22 2 15 22 11 13 2 9 22 2"></polygon></svg>
                </button>
            </div>
            <div class="suggested-prompts">
                <span class="prompt-chip" @onclick='() => SendSuggested("Which providers have excessive ER utilization?")'>Which providers have excessive ER utilization?</span>
                <span class="prompt-chip" @onclick='() => SendSuggested("Identify top 3 care gap opportunities")'>Identify top 3 care gap opportunities</span>
                <span class="prompt-chip" @onclick='() => SendSuggested("Show readmission drivers")'>Show readmission drivers</span>
            </div>
        </div>
    </div>
</div>

<!-- Data Table Section removed per user request -->
<style>
    .table-row-hover:hover { background: #f8fafc; cursor: default; }
</style>

@code {
    public class ChatMessage { public string Role { get; set; } = ""; public string Text { get; set; } = ""; }
    public class PatientData
    {
        public int UserId { get; set; }
        public string Name { get; set; } = "";
        public decimal Expense { get; set; }
        public string HealthCarePlan { get; set; } = "";
        public decimal Pmpm { get; set; }
        public string RiskTier { get; set; } = "";
        public double ERUtilization { get; set; }
        public int OpenCareGaps { get; set; }
        public decimal SpecificAttachmentPoint { get; set; }
        public string ClaimStatus { get; set; } = "";
        public string DenialReason { get; set; } = "";
        public DateTime FilingDeadline { get; set; }
        public string ProviderName { get; set; } = "";
        public bool HasSpecialAttachmentPoint { get; set; }
    }
    private List<ChatMessage> Messages = new();
    private string CurrentMessage = "";
    private bool IsLoading = false;
    private bool ShowLogoutMenu = false;

    private List<PatientData>? Patients;
    
    private int? _selectedPatientId = null;
    private PatientData? SelectedPatient => Patients?.FirstOrDefault(p => p.UserId == _selectedPatientId);

    // Aggregate properties for overall view
    private decimal OverallPmpm => Patients?.Any() == true ? Math.Round(Patients.Average(p => p.Pmpm), 0) : 0;
    private string OverallRiskTier => Patients?.Any() == true ? $"{Patients.Count(p => p.RiskTier.Contains("High") || p.RiskTier.Contains("Critical"))} High/Crit" : "N/A";
    private double OverallER => Patients?.Any() == true ? Math.Round(Patients.Average(p => p.ERUtilization), 1) : 0;
    private int OverallCareGaps => Patients?.Any() == true ? Patients.Sum(p => p.OpenCareGaps) : 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadDataFromDatabase();
    }

    private async Task LoadDataFromDatabase()
    {
        try
        {
            Patients = new List<PatientData>();
            using var scope = ServiceProvider.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();
            
            var dbPatients = await db.Patients.ToListAsync();
            int userIdCounter = 1;
            
            foreach (var dbp in dbPatients)
            {
                Patients.Add(new PatientData
                {
                    UserId = userIdCounter++,
                    Name = dbp.Name,
                    Expense = dbp.Expense,
                    HealthCarePlan = dbp.HealthCarePlan,
                    Pmpm = dbp.Pmpm,
                    RiskTier = dbp.RiskTier,
                    ERUtilization = dbp.ERUtilization,
                    OpenCareGaps = dbp.OpenCareGaps,
                    SpecificAttachmentPoint = dbp.SpecificAttachmentPoint,
                    ClaimStatus = dbp.ClaimStatus,
                    DenialReason = dbp.DenialReason,
                    FilingDeadline = dbp.FilingDeadline,
                    ProviderName = dbp.ProviderName,
                    HasSpecialAttachmentPoint = dbp.HasSpecialAttachmentPoint
                });
            }
            
            _selectedPatientId = null;
        }
        catch
        {
            // Fallback gracefully
        }
    }

    private void ToggleLogoutMenu() => ShowLogoutMenu = !ShowLogoutMenu;
    private void CancelLogout() => ShowLogoutMenu = false;

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SendMessage();
    }

    private async Task SendSuggested(string prompt)
    {
        CurrentMessage = prompt;
        await SendMessage();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(CurrentMessage)) return;

        var userMsg = CurrentMessage;
        
        // Smart Context Switching
        if (Patients != null)
        {
            var matchedPatient = Patients.OrderByDescending(p => p.Name.Length).FirstOrDefault(p => userMsg.Contains(p.Name, StringComparison.OrdinalIgnoreCase));
            if (matchedPatient != null)
            {
                _selectedPatientId = matchedPatient.UserId;
            }
            else
            {
                _selectedPatientId = null;
            }
        }

        Messages.Add(new ChatMessage { Role = "User", Text = userMsg });
        CurrentMessage = "";
        IsLoading = true;
        await InvokeAsync(StateHasChanged);

        var aiMsg = new ChatMessage { Role = "AI", Text = "Thinking..." };
        Messages.Add(aiMsg);
        await InvokeAsync(StateHasChanged);

        try
        {
            var contextData = Patients != null ? JsonSerializer.Serialize(Patients) : "No data available";

            bool firstChunk = true;
            var lastUpdate = DateTime.UtcNow;
            await foreach (var chunk in AI.GenerateSqlResponseStreamAsync(userMsg, DbQueryService))
            {
                if (firstChunk)
                {
                    aiMsg.Text = "";
                    firstChunk = false;
                }
                if (chunk.StartsWith("[CLEAR]"))
                {
                    aiMsg.Text = chunk.Substring(7);
                }
                else
                {
                    aiMsg.Text += chunk;
                }
                
                // Throttle UI updates to 10 times a second max to prevent UI freeze
                if ((DateTime.UtcNow - lastUpdate).TotalMilliseconds > 100)
                {
                    await InvokeAsync(StateHasChanged);
                    lastUpdate = DateTime.UtcNow;
                }
            }
            if (firstChunk)
            {
                // In case of an empty response
                aiMsg.Text = "No response generated.";
            }
        }
        catch (Exception ex)
        {
            aiMsg.Text = $"\n(Error reading response: {ex.Message})";
        }

        IsLoading = false;
        await InvokeAsync(StateHasChanged);
    }
}
